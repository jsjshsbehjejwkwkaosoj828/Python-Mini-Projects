#:import dp kivy.metrics.dp

<NoteCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(116)
    padding: dp(16), dp(13)
    spacing: dp(7)
    canvas.before:
        Color:
            rgba: (0.105, 0.13, 0.19, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(17)]
        Color:
            rgba: (0.22, 0.28, 0.39, 0.55)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(17))
            width: 0.8
    BoxLayout:
        size_hint_y: None
        height: dp(25)
        Label:
            text: root.note_title
            color: (0.94, 0.96, 1, 1)
            font_size: "16sp"
            bold: True
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True
        Label:
            text: "✎"
            color: (0.52, 0.64, 1, 1)
            font_size: "18sp"
            size_hint_x: None
            width: dp(24)
    Label:
        text: root.note_preview
        color: (0.65, 0.70, 0.79, 1)
        font_size: "13sp"
        halign: "left"
        valign: "top"
        text_size: self.size
        shorten: True
    BoxLayout:
        size_hint_y: None
        height: dp(22)
        Label:
            text: root.note_date
            color: (0.43, 0.50, 0.62, 1)
            font_size: "10sp"
            halign: "left"
            valign: "middle"
            text_size: self.size
        Button:
            text: "باز کردن"
            size_hint_x: None
            width: dp(76)
            background_normal: ""
            background_color: (0.22, 0.31, 0.52, 1)
            color: (0.88, 0.92, 1, 1)
            font_size: "11sp"
            on_release: app.root.open_editor(root.note_id)
    Button:
        text: "حذف"
        size_hint: None, None
        size: dp(54), dp(26)
        pos_hint: {"right": 1}
        background_normal: ""
        background_color: (0.34, 0.16, 0.20, 1)
        color: (1, 0.70, 0.72, 1)
        font_size: "10sp"
        on_release: app.root.confirm_delete(root.note_id)

<NotesRoot>:
    orientation: "vertical"
    padding: dp(20), dp(18), dp(20), dp(14)
    spacing: dp(14)
    canvas.before:
        Color:
            rgba: (0.055, 0.067, 0.10, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: None
        height: dp(42)
        Label:
            text: "NOTES"
            color: (0.53, 0.67, 1, 1)
            bold: True
            font_size: "12sp"
            letter_spacing: 3
            halign: "left"
            valign: "middle"
            text_size: self.size
        Label:
            text: "✦  فضای شخصی تو"
            color: (0.58, 0.64, 0.75, 1)
            font_size: "11sp"
            halign: "right"
            valign: "middle"
            text_size: self.size

    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: dp(106)
        padding: dp(17), dp(12)
        spacing: dp(4)
        canvas.before:
            Color:
                rgba: (0.15, 0.20, 0.32, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(20)]
        Label:
            text: "یادداشت‌هات، مرتب و دم‌دست"
            color: (0.96, 0.97, 1, 1)
            font_size: "19sp"
            bold: True
            halign: "right"
            valign: "middle"
            text_size: self.size
        Label:
            text: "ایده‌ها و کارهای مهمت رو همین‌جا نگه دار."
            color: (0.72, 0.78, 0.89, 1)
            font_size: "12sp"
            halign: "right"
            valign: "middle"
            text_size: self.size

    BoxLayout:
        size_hint_y: None
        height: dp(48)
        padding: dp(12), 0
        canvas.before:
            Color:
                rgba: (0.105, 0.13, 0.19, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(13)]
        Label:
            text: "⌕"
            color: (0.60, 0.69, 0.88, 1)
            font_size: "25sp"
            size_hint_x: None
            width: dp(30)
        TextInput:
            hint_text: "جست‌وجو در یادداشت‌ها..."
            hint_text_color: (0.43, 0.50, 0.62, 1)
            foreground_color: (0.93, 0.95, 1, 1)
            cursor_color: (0.48, 0.63, 1, 1)
            background_normal: ""
            background_active: ""
            background_color: (0, 0, 0, 0)
            multiline: False
            font_size: "13sp"
            on_text: root.on_search(self.text)

    BoxLayout:
        size_hint_y: None
        height: dp(30)
        Label:
            text: "یادداشت‌های من"
            color: (0.93, 0.95, 1, 1)
            font_size: "16sp"
            bold: True
            halign: "left"
            valign: "middle"
            text_size: self.size
        Label:
            text: root.note_count
            color: (0.52, 0.61, 0.77, 1)
            font_size: "11sp"
            halign: "right"
            valign: "middle"
            text_size: self.size

    FloatLayout:
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            scroll_type: ["bars", "content"]
            GridLayout:
                id: notes_list
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(11)
        Label:
            id: empty_state
            text: root.empty_message + "\\nاز دکمه پایین برای ساخت اولین یادداشتت استفاده کن."
            color: (0.43, 0.51, 0.65, 1)
            font_size: "13sp"
            halign: "center"
            valign: "middle"
            text_size: self.size
            size_hint: 1, 1
            opacity: 0

    Button:
        text: "+   یادداشت جدید"
        size_hint_y: None
        height: dp(52)
        background_normal: ""
        background_down: ""
        background_color: (0.31, 0.43, 0.78, 1)
        color: (1, 1, 1, 1)
        bold: True
        font_size: "15sp"
        on_release: root.open_new_note()

<NoteEditor>:
    orientation: "vertical"
    padding: dp(18)
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: (0.075, 0.09, 0.14, 1)
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: "ویرایش یادداشت" if root.is_edit else "یادداشت جدید"
        size_hint_y: None
        height: dp(34)
        color: (0.95, 0.96, 1, 1)
        font_size: "18sp"
        bold: True
        halign: "right"
        valign: "middle"
        text_size: self.size
    TextInput:
        id: title_input
        text: root.title_text
        hint_text: "عنوان یادداشت"
        size_hint_y: None
        height: dp(48)
        multiline: False
        font_size: "15sp"
        padding: dp(12), dp(13)
        foreground_color: (0.95, 0.96, 1, 1)
        hint_text_color: (0.47, 0.54, 0.66, 1)
        cursor_color: (0.50, 0.65, 1, 1)
        background_normal: ""
        background_active: ""
        background_color: (0.13, 0.16, 0.23, 1)
    TextInput:
        id: body_input
        text: root.body_text
        hint_text: "هر چیزی که می‌خوای اینجا بنویس..."
        font_size: "14sp"
        padding: dp(12)
        foreground_color: (0.90, 0.92, 0.97, 1)
        hint_text_color: (0.47, 0.54, 0.66, 1)
        cursor_color: (0.50, 0.65, 1, 1)
        background_normal: ""
        background_active: ""
        background_color: (0.13, 0.16, 0.23, 1)
    BoxLayout:
        size_hint_y: None
        height: dp(48)
        spacing: dp(10)
        Button:
            text: "انصراف"
            background_normal: ""
            background_color: (0.18, 0.22, 0.30, 1)
            on_release: root.popup.dismiss()
        Button:
            text: "ذخیره یادداشت"
            background_normal: ""
            background_color: (0.31, 0.43, 0.78, 1)
            bold: True
            on_release: root.save()
